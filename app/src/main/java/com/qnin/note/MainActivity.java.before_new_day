    private EditText qninPasswordInput(String hint) {
        LinearLayout wrap = new LinearLayout(this);
        wrap.setOrientation(LinearLayout.HORIZONTAL);

        EditText input = new EditText(this);
        input.setHint(hint);
        input.setHintTextColor(QNIN_MUTED);
